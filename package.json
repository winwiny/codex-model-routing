{
  "name": "codex-model-routing-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cross-platform local CLI and MCP bridge for TypeSafe Jev.",
  "bin": {
    "jev": "./scripts/jev-cli.mjs",
    "jev-mcp": "./scripts/jev-mcp-server.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:mcp": "node --test tests/jev-mcp-server.test.mjs",
    "start:mcp": "node scripts/jev-mcp-server.mjs",
    "check": "node scripts/jev-cli.mjs doctor"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@typesafe-ai/sdk": "0.6.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
